# Credenciales locales: copia este archivo como .env y cambia todos estos valores.
# La imagen oficial de MySQL solo aplica estas cuentas al crear un volumen vacío.
# Evita comillas y barras invertidas en este ejemplo porque se usan en comandos SQL.
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=app
MYSQL_USER=appuser
MYSQL_PASSWORD=apppass
# Cuenta separada: ProxySQL solo la usa para consultar la membresía del clúster.
MYSQL_MONITOR_PASSWORD=monitorpass
# Cuenta separada: Prometheus la usa para leer métricas, no para escribir datos.
MYSQL_EXPORTER_PASSWORD=exporterpass
# Credenciales administrativas internas; el puerto 6032 no se publica al host.
PROXYSQL_ADMIN_USER=clusteradmin
PROXYSQL_ADMIN_PASSWORD=adminpass
# Cambia estas credenciales antes de permitir acceso a Grafana desde otros equipos.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambia-esta-clave
# URL HTTPS de la carpeta WebDAV configurada en IIS para recibir copias.
# Estas variables solo son necesarias al activar el perfil opcional backup.
BACKUP_IIS_URL=https://192.168.1.10/observability-backups
BACKUP_IIS_USERNAME=usuario-backup
BACKUP_IIS_PASSWORD=cambia-esta-clave
# Intervalo entre copias, en segundos (86400 = 24 horas).
BACKUP_INTERVAL_SECONDS=86400
# Interfaz de red del host Linux que Suricata inspeccionará (p. ej. eth0 o enp1s0).
# Solo tiene efecto en Linux al activar el perfil security.
SURICATA_INTERFACE=eth0
