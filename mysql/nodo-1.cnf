# Identidad propia de este servidor MySQL.
[mysqld]
server_id=1
report_host=mysql-1

# Activa binlogs y GTID, necesarios para la replicación del clúster.
# ROW registra cada cambio de fila, lo que permite replicar operaciones de forma consistente.
log_bin=binlog
binlog_format=ROW
# Group Replication requiere checksum desactivado para intercambiar eventos compatibles.
binlog_checksum=NONE
# GTID identifica transacciones globalmente y evita depender de offsets de binlog.
gtid_mode=ON
enforce_gtid_consistency=ON
# Reenvía cambios replicados a los binlogs locales de cada miembro.
log_replica_updates=ON
# Reduce dependencias entre transacciones concurrentes que afectan filas distintas.
binlog_transaction_dependency_tracking=WRITESET
transaction_write_set_extraction=XXHASH64

# Carga Group Replication sin iniciar una elección antes de crear el clúster.
plugin_load_add=group_replication.so
loose-group_replication_group_name=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
loose-group_replication_local_address=mysql-1:33061
loose-group_replication_group_seeds=mysql-1:33061,mysql-2:33061,mysql-3:33061
# El inicializador recupera primero el clúster y luego persiste el inicio automático.
loose-group_replication_start_on_boot=OFF
# Evita que un reinicio del nodo intente crear otro grupo por su cuenta.
loose-group_replication_bootstrap_group=OFF
